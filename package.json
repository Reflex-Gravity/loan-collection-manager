{
  "name": "loan-collection-manager",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace @lcm/shared build\" \"yarn dev:api\" \"yarn dev:web\"",
    "dev:api": "yarn workspace @lcm/api start:dev",
    "dev:web": "yarn workspace @lcm/web dev",
    "build": "yarn workspaces run build",
    "docker:up": "cp -n apps/api/.env.example apps/api/.env; docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
